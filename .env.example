# CLI example only. The Mac App stores secrets in Keychain instead.
# Copy to .env and fill in your own values; never share the resulting .env.
StuId=
UISPsw=
COURSE_IDS=12345
COURSE_SKIP_TIME_PERIODS=

# One OpenAI-compatible provider. Normal success uses one request per lecture.
# DeepSeek official documentation: https://api-docs.deepseek.com/
LLM_NAME_1=deepseek
LLM_API_KEY_1=
LLM_BASE_URL_1=https://api.deepseek.com
LLM_MODELS_1=deepseek-v4-flash
LLM_API_STYLE_1=openai
LLM_MAX_OUTPUT_TOKENS=65536
API_TIMEOUT_MS=1200000

# Empty paths use ~/iCourse/课程 and ~/iCourse/笔记 on Mac.
# Use an actual absolute path; .env is not a shell and does not expand $HOME.
DOWNLOAD_DIR=
SUMMARY_DIR=

# Cloud speech: OpenAI-compatible multipart POST /audio/transcriptions.
# Base URL may also be the full transcription endpoint. No local model fallback.
ASR_PROVIDER=openai
ASR_BASE_URL=https://api.siliconflow.cn/v1
ASR_MODEL=XingChenAGI/XingChenASR-V3.2-Ultra
ASR_API_KEY=""
# Audio upload limits
ASR_CHUNK_SECONDS=300
ASR_MAX_UPLOAD_MB=20
ASR_TIMEOUT_SECONDS=300
ASR_RETRIES=2
# Leave optional parameters empty unless supported by your speech provider.
ASR_LANGUAGE=
ASR_INITIAL_PROMPT=
ASR_RESPONSE_FORMAT=

# Alibaba file ASR alternative: replace the ASR_PROVIDER/BASE_URL/MODEL/API_KEY
# values above (do not add duplicate keys). Both models provide subtitle timing.
# ASR_PROVIDER=dashscope
# ASR_BASE_URL=https://dashscope.aliyuncs.com/api/v1
# ASR_MODEL=fun-asr
# Or: ASR_MODEL=paraformer-v2
# ASR_API_KEY=your own Beijing-region Alibaba Model Studio key
# ASR_LANGUAGE=zh,en
# Keep ASR_INITIAL_PROMPT and ASR_RESPONSE_FORMAT empty for this provider.

# Legacy main.py email/database workflow; not used by the standard Mac App.
SMTP_EMAIL=
SMTP_PASSWORD=
RECEIVER_EMAIL=
DATA_DIR=data
DB_PATH=data/icourse.db
